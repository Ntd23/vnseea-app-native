# Description: Example local environment for React Native backend API integration.
API_BASE_URL=https://v2.vnseea.vn/api
WEB_BASE_URL=https://v2.vnseea.vn
SOCKET_URL=https://v2.vnseea.vn
SERVER_KEY=replace_with_server_key_from_backend_config
REQUEST_TIMEOUT_MS=15000
ONESIGNAL_APP_ID=replace_with_onesignal_app_id
GOOGLE_MAPS_API_KEY=replace_with_google_maps_android_api_key
GOOGLE_MAPS_ANDROID_CERT_SHA1=replace_with_android_signing_certificate_sha1_without_colons
GOOGLE_MAPS_ANDROID_CERT_SHA1_RELEASE=replace_with_google_play_app_signing_certificate_sha1_without_colons
GOOGLE_MAPS_IOS_API_KEY=replace_with_google_maps_ios_api_key_optional
GOOGLE_MAPS_MAP_ID=replace_with_google_cloud_map_id
LIVEKIT_WS_URL=wss://replace_with_livekit_host
