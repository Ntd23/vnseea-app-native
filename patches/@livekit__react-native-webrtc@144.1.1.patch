+static NSString *VNSEEAPortTypesForAudioSessionPorts(NSArray<AVAudioSessionPortDescription *> *ports) {
+    NSMutableArray<NSString *> *portTypes = [NSMutableArray array];
+    for (AVAudioSessionPortDescription *port in ports) {
+        if (port.portType != nil) {
+            [portTypes addObject:port.portType];
+        }
+    }
+    return [portTypes componentsJoinedByString:@","];
+}
+
+static NSString *VNSEEAPortDescriptionsForAudioSessionPorts(NSArray<AVAudioSessionPortDescription *> *ports) {
+    NSMutableArray<NSString *> *descriptions = [NSMutableArray array];
+    for (AVAudioSessionPortDescription *port in ports) {
+        [descriptions addObject:[NSString stringWithFormat:@"%@:%@",
+                                 port.portType ?: @"",
+                                 port.portName ?: @""]];
+    }
+    return [descriptions componentsJoinedByString:@","];
+}
+
+static NSString *VNSEEARecordPermissionName(AVAudioSessionRecordPermission permission) {
+    switch (permission) {
+        case AVAudioSessionRecordPermissionGranted:
+            return @"granted";
+        case AVAudioSessionRecordPermissionDenied:
+            return @"denied";
+        case AVAudioSessionRecordPermissionUndetermined:
+        default:
+            return @"undetermined";
+    }
+}
+
+static BOOL VNSEEAAudioSessionPortsContainType(
+    NSArray<AVAudioSessionPortDescription *> *ports,
+    NSString *portType) {
+    for (AVAudioSessionPortDescription *port in ports) {
+        if ([port.portType isEqualToString:portType]) {
+            return YES;
+        }
+    }
+    return NO;
+}
+
+static BOOL VNSEEAAudioSessionCurrentRouteUsesBluetoothHFP(AVAudioSession *audioSession) {
+    AVAudioSessionRouteDescription *route = audioSession.currentRoute;
+    return VNSEEAAudioSessionPortsContainType(route.inputs, AVAudioSessionPortBluetoothHFP) ||
+        VNSEEAAudioSessionPortsContainType(route.outputs, AVAudioSessionPortBluetoothHFP);
+}
+
+static AVAudioSessionPortDescription *VNSEEAAudioSessionPreferredInputForRecording(AVAudioSession *audioSession) {
+    NSArray<AVAudioSessionPortDescription *> *availableInputs = audioSession.availableInputs ?: @[];
+    BOOL routeUsesBluetoothHFP = VNSEEAAudioSessionCurrentRouteUsesBluetoothHFP(audioSession);
+    if (routeUsesBluetoothHFP) {
+        for (AVAudioSessionPortDescription *input in availableInputs) {
+            if ([input.portType isEqualToString:AVAudioSessionPortBluetoothHFP]) {
+                return input;
+            }
+        }
+    }
+
+    for (AVAudioSessionPortDescription *input in availableInputs) {
+        if ([input.portType isEqualToString:AVAudioSessionPortBuiltInMic]) {
+            return input;
+        }
+    }
+
+    for (AVAudioSessionPortDescription *input in availableInputs) {
+        if ([input.portType isEqualToString:AVAudioSessionPortBluetoothHFP]) {
+            return input;
+        }
+    }
+
+    return availableInputs.firstObject;
+}
+
