+static NSString *VNSEEAWebRTCAudioRecordPermissionString(AVAudioSessionRecordPermission permission)
+{
+    switch (permission) {
+        case AVAudioSessionRecordPermissionGranted:
+            return @"granted";
+        case AVAudioSessionRecordPermissionDenied:
+            return @"denied";
+        case AVAudioSessionRecordPermissionUndetermined:
+        default:
+            return @"undetermined";
+    }
+}
+
+static NSArray *VNSEEAWebRTCAudioRoutePorts(NSArray<AVAudioSessionPortDescription *> *ports)
+{
+    NSMutableArray *result = [NSMutableArray arrayWithCapacity:ports.count];
+    for (AVAudioSessionPortDescription *port in ports) {
+        [result addObject:@{
+            @"portName": port.portName ?: @"",
+            @"portType": port.portType ?: @"",
+            @"uid": port.UID ?: @"",
+        }];
+    }
+    return result;
+}
+
+static AVAudioSessionCategoryOptions VNSEEACallKitVoiceAudioOptions(void)
+{
+    return AVAudioSessionCategoryOptionAllowBluetoothHFP |
+        AVAudioSessionCategoryOptionDefaultToSpeaker;
+}
+
+static RTCAudioSessionConfiguration *VNSEEACallKitVoiceWebRTCConfiguration(void)
+{
+    RTCAudioSessionConfiguration *voiceConfig = [RTCAudioSessionConfiguration webRTCConfiguration];
+    voiceConfig.category = AVAudioSessionCategoryPlayAndRecord;
+    voiceConfig.mode = AVAudioSessionModeVoiceChat;
+    voiceConfig.categoryOptions = VNSEEACallKitVoiceAudioOptions();
+    [RTCAudioSessionConfiguration setWebRTCConfiguration:voiceConfig];
+    return voiceConfig;
+}
+
+static void VNSEEACallKitVoiceAudioTrace(NSString *stage)
+{
+    AVAudioSession *session = [AVAudioSession sharedInstance];
+    RTCAudioSessionConfiguration *webRTCConfig = [RTCAudioSessionConfiguration webRTCConfiguration];
+    NSLog(
+        @"VNSEEA_CALLKIT_AUDIO_TRACE %@ avCategory=%@ avMode=%@ avOptions=%lu webRTCConfigCategory=%@ webRTCConfigMode=%@ webRTCConfigOptions=%lu",
+        stage ?: @"",
+        session.category ?: @"",
+        session.mode ?: @"",
+        (unsigned long)session.categoryOptions,
+        webRTCConfig.category ?: @"",
+        webRTCConfig.mode ?: @"",
+        (unsigned long)webRTCConfig.categoryOptions
+    );
+}
+
+static NSDictionary *VNSEEAWebRTCAudioSessionState(NSString *stage, NSError *configurationError, NSError *activeError)
+{
+    AVAudioSession *session = [AVAudioSession sharedInstance];
+    RTCAudioSessionConfiguration *webRTCConfig = [RTCAudioSessionConfiguration webRTCConfiguration];
+    NSMutableDictionary *state = [@{
+        @"stage": stage ?: @"",
+        @"category": session.category ?: @"",
+        @"mode": session.mode ?: @"",
+        @"categoryOptions": @(session.categoryOptions),
+        @"webRTCConfigCategory": webRTCConfig.category ?: @"",
+        @"webRTCConfigMode": webRTCConfig.mode ?: @"",
+        @"webRTCConfigOptions": @(webRTCConfig.categoryOptions),
+        @"webRTCConfigHasAllowBluetooth": @((webRTCConfig.categoryOptions & AVAudioSessionCategoryOptionAllowBluetoothHFP) != 0),
+        @"webRTCConfigHasDefaultToSpeaker": @((webRTCConfig.categoryOptions & AVAudioSessionCategoryOptionDefaultToSpeaker) != 0),
+        @"hasAllowBluetooth": @((session.categoryOptions & AVAudioSessionCategoryOptionAllowBluetoothHFP) != 0),
+        @"hasDefaultToSpeaker": @((session.categoryOptions & AVAudioSessionCategoryOptionDefaultToSpeaker) != 0),
+        @"recordPermission": VNSEEAWebRTCAudioRecordPermissionString(session.recordPermission),
+        @"inputAvailable": @(session.inputAvailable),
+        @"currentRouteInputs": VNSEEAWebRTCAudioRoutePorts(session.currentRoute.inputs),
+        @"currentRouteOutputs": VNSEEAWebRTCAudioRoutePorts(session.currentRoute.outputs),
+        @"sampleRate": @(session.sampleRate),
+        @"IOBufferDuration": @(session.IOBufferDuration),
+        @"isOtherAudioPlaying": @(session.isOtherAudioPlaying),
+    } mutableCopy];
+
+    if (configurationError != nil) {
+        state[@"configurationError"] = @{
+            @"domain": configurationError.domain ?: @"",
+            @"code": @(configurationError.code),
+            @"message": configurationError.localizedDescription ?: @"",
+        };
+    }
+    if (activeError != nil) {
+        state[@"activeError"] = @{
+            @"domain": activeError.domain ?: @"",
+            @"code": @(activeError.code),
+            @"message": activeError.localizedDescription ?: @"",
+        };
+    }
+
+    return state;
+}
+
