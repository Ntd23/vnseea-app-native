+static NSString *VNSEEAPortTypesForAudioSessionPorts(NSArray<AVAudioSessionPortDescription *> *ports) {
+    NSMutableArray<NSString *> *portTypes = [NSMutableArray array];
+    for (AVAudioSessionPortDescription *port in ports) {
+        if (port.portType != nil) {
+            [portTypes addObject:port.portType];
+        }
+    }
+    return [portTypes componentsJoinedByString:@","];
+}
+
+static NSString *VNSEEAPortDescriptionsForAudioSessionPorts(NSArray<AVAudioSessionPortDescription *> *ports) {
+    NSMutableArray<NSString *> *descriptions = [NSMutableArray array];
+    for (AVAudioSessionPortDescription *port in ports) {
+        [descriptions addObject:[NSString stringWithFormat:@"%@:%@",
+                                 port.portType ?: @"",
+                                 port.portName ?: @""]];
+    }
+    return [descriptions componentsJoinedByString:@","];
+}
+
+static NSString *VNSEEARecordPermissionName(AVAudioSessionRecordPermission permission) {
+    switch (permission) {
+        case AVAudioSessionRecordPermissionGranted:
+            return @"granted";
+        case AVAudioSessionRecordPermissionDenied:
+            return @"denied";
+        case AVAudioSessionRecordPermissionUndetermined:
+        default:
+            return @"undetermined";
+    }
+}
+
+static BOOL VNSEEAAudioSessionPortsContainType(
+    NSArray<AVAudioSessionPortDescription *> *ports,
+    NSString *portType) {
+    for (AVAudioSessionPortDescription *port in ports) {
+        if ([port.portType isEqualToString:portType]) {
+            return YES;
+        }
+    }
+    return NO;
+}
+
+static BOOL VNSEEAAudioSessionCurrentRouteUsesBluetoothHFP(AVAudioSession *audioSession) {
+    AVAudioSessionRouteDescription *route = audioSession.currentRoute;
+    return VNSEEAAudioSessionPortsContainType(route.inputs, AVAudioSessionPortBluetoothHFP) ||
+        VNSEEAAudioSessionPortsContainType(route.outputs, AVAudioSessionPortBluetoothHFP);
+}
+
+static AVAudioSessionPortDescription *VNSEEAAudioSessionPreferredInputForRecording(AVAudioSession *audioSession) {
+    NSArray<AVAudioSessionPortDescription *> *availableInputs = audioSession.availableInputs ?: @[];
+    BOOL routeUsesBluetoothHFP = VNSEEAAudioSessionCurrentRouteUsesBluetoothHFP(audioSession);
+    if (routeUsesBluetoothHFP) {
+        for (AVAudioSessionPortDescription *input in availableInputs) {
+            if ([input.portType isEqualToString:AVAudioSessionPortBluetoothHFP]) {
+                return input;
+            }
+        }
+    }
+
+    for (AVAudioSessionPortDescription *input in availableInputs) {
+        if ([input.portType isEqualToString:AVAudioSessionPortBuiltInMic]) {
+            return input;
+        }
+    }
+
+    for (AVAudioSessionPortDescription *input in availableInputs) {
+        if ([input.portType isEqualToString:AVAudioSessionPortBluetoothHFP]) {
+            return input;
+        }
+    }
+
+    return availableInputs.firstObject;
+}
+
+static void VNSEEALogWebRTCAudioInputProbe(
+    NSString *event,
+    RTCAudioDeviceModule * _Nullable audioDeviceModule,
+    AVAudioEngine * _Nullable engine,
+    BOOL isPlayoutEnabled,
+    BOOL isRecordingEnabled,
+    NSError * _Nullable error) {
+    AVAudioSession *audioSession = [AVAudioSession sharedInstance];
+    AVAudioSessionRouteDescription *route = audioSession.currentRoute;
+    AVAudioSessionPortDescription *preferredInput = audioSession.preferredInput;
+    AVAudioSessionPortDescription *selectedInput = route.inputs.firstObject;
+    float inputGain = audioSession.inputGainSettable ? audioSession.inputGain : -1.0f;
+    NSLog(
+        @"[VNSEEA_CALL_DEBUG] {\"event\":\"%@\",\"isPlayoutEnabled\":%@,\"isRecordingEnabled\":%@,\"isPlaying\":%@,\"isRecording\":%@,\"isEngineRunning\":%@,\"avAudioEngineRunning\":%@,\"isMicrophoneMuted\":%@,\"category\":\"%@\",\"mode\":\"%@\",\"categoryOptions\":%lu,\"inputAvailable\":%@,\"recordPermission\":\"%@\",\"inputGain\":%.3f,\"inputGainSettable\":%@,\"sampleRate\":%.0f,\"ioBufferDuration\":%.4f,\"selectedInput\":\"%@:%@\",\"preferredInput\":\"%@:%@\",\"availableInputs\":\"%@\",\"routeInputs\":\"%@\",\"routeOutputs\":\"%@\",\"error\":\"%@\"}",
+        event,
+        isPlayoutEnabled ? @"true" : @"false",
+        isRecordingEnabled ? @"true" : @"false",
+        audioDeviceModule != nil && audioDeviceModule.isPlaying ? @"true" : @"false",
+        audioDeviceModule != nil && audioDeviceModule.isRecording ? @"true" : @"false",
+        audioDeviceModule != nil && audioDeviceModule.isEngineRunning ? @"true" : @"false",
+        engine != nil && engine.isRunning ? @"true" : @"false",
+        audioDeviceModule != nil && audioDeviceModule.isMicrophoneMuted ? @"true" : @"false",
+        audioSession.category ?: @"",
+        audioSession.mode ?: @"",
+        (unsigned long)audioSession.categoryOptions,
+        audioSession.isInputAvailable ? @"true" : @"false",
+        VNSEEARecordPermissionName(audioSession.recordPermission),
+        inputGain,
+        audioSession.inputGainSettable ? @"true" : @"false",
+        audioSession.sampleRate,
+        audioSession.IOBufferDuration,
+        selectedInput.portType ?: @"",
+        selectedInput.portName ?: @"",
+        preferredInput.portType ?: @"",
+        preferredInput.portName ?: @"",
+        VNSEEAPortDescriptionsForAudioSessionPorts(audioSession.availableInputs ?: @[]),
+        VNSEEAPortDescriptionsForAudioSessionPorts(route.inputs),
+        VNSEEAPortDescriptionsForAudioSessionPorts(route.outputs),
+        error.localizedDescription ?: @"");
+}
+
+static void VNSEEAEnsureValidRecordingRoute(BOOL isPlayoutEnabled, BOOL isRecordingEnabled) {
+    if (!isRecordingEnabled) {
+        return;
+    }
+
+    AVAudioSession *audioSession = [AVAudioSession sharedInstance];
+    AVAudioSessionPortDescription *preferredInput = VNSEEAAudioSessionPreferredInputForRecording(audioSession);
+    if (preferredInput != nil && ![audioSession.preferredInput.UID isEqualToString:preferredInput.UID]) {
+        NSError *inputError = nil;
+        if (![audioSession setPreferredInput:preferredInput error:&inputError]) {
+            VNSEEALogWebRTCAudioInputProbe(
+                @"native_webrtc_audio_input_probe", nil, nil, isPlayoutEnabled, isRecordingEnabled, inputError);
+            return;
+        }
+    }
+
+    if (!VNSEEAAudioSessionCurrentRouteUsesBluetoothHFP(audioSession)) {
+        NSError *routeError = nil;
+        if (![audioSession overrideOutputAudioPort:AVAudioSessionPortOverrideSpeaker error:&routeError]) {
+            VNSEEALogWebRTCAudioInputProbe(
+                @"native_webrtc_audio_input_probe", nil, nil, isPlayoutEnabled, isRecordingEnabled, routeError);
+            return;
+        }
+    }
+
+    VNSEEALogWebRTCAudioInputProbe(
+        @"native_webrtc_audio_input_probe", nil, nil, isPlayoutEnabled, isRecordingEnabled, nil);
+}
+
+static void VNSEEALogWebRTCAudioSessionState(
+    NSString *event,
+    BOOL isPlayoutEnabled,
+    BOOL isRecordingEnabled,
+    NSError * _Nullable error) {
+    AVAudioSession *audioSession = [AVAudioSession sharedInstance];
+    AVAudioSessionRouteDescription *route = audioSession.currentRoute;
+    NSLog(
+        @"[VNSEEA_CALL_DEBUG] {\"event\":\"%@\",\"isPlayoutEnabled\":%@,\"isRecordingEnabled\":%@,\"category\":\"%@\",\"mode\":\"%@\",\"inputAvailable\":%@,\"recordPermission\":\"%@\",\"sampleRate\":%.0f,\"ioBufferDuration\":%.4f,\"inputs\":\"%@\",\"outputs\":\"%@\",\"error\":\"%@\"}",
+        event,
+        isPlayoutEnabled ? @"true" : @"false",
+        isRecordingEnabled ? @"true" : @"false",
+        audioSession.category ?: @"",
+        audioSession.mode ?: @"",
+        audioSession.isInputAvailable ? @"true" : @"false",
+        VNSEEARecordPermissionName(audioSession.recordPermission),
+        audioSession.sampleRate,
+        audioSession.IOBufferDuration,
+        VNSEEAPortTypesForAudioSessionPorts(route.inputs),
+        VNSEEAPortTypesForAudioSessionPorts(route.outputs),
+        error.localizedDescription ?: @"");
+}
+
+static BOOL VNSEEAShouldUseVoiceCallAudioSession(BOOL isRecordingEnabled) {
+    if (isRecordingEnabled) {
+        return YES;
+    }
+
+    AVAudioSession *audioSession = [AVAudioSession sharedInstance];
+    return [audioSession.category isEqualToString:AVAudioSessionCategoryPlayAndRecord] &&
+        ([audioSession.mode isEqualToString:AVAudioSessionModeVoiceChat] ||
+         [audioSession.mode isEqualToString:AVAudioSessionModeVideoChat]);
+}
+
+static NSString *VNSEEAAudioSessionModeForEngine(void) {
+    return AVAudioSessionModeVoiceChat;
+}
+
+static void VNSEEAConfigureAudioSessionForEngine(BOOL isPlayoutEnabled, BOOL isRecordingEnabled) {
+    if (!VNSEEAShouldUseVoiceCallAudioSession(isRecordingEnabled)) {
+        return;
+    }
+
+    NSError *error = nil;
+    AVAudioSession *audioSession = [AVAudioSession sharedInstance];
+    AVAudioSessionCategoryOptions categoryOptions =
+        AVAudioSessionCategoryOptionAllowBluetoothHFP |
+        AVAudioSessionCategoryOptionDefaultToSpeaker |
+        AVAudioSessionCategoryOptionMixWithOthers;
+
+    if (![audioSession setCategory:AVAudioSessionCategoryPlayAndRecord
+                       withOptions:categoryOptions
+                             error:&error]) {
+        VNSEEALogWebRTCAudioSessionState(
+            @"native_webrtc_audio_session_config_error", isPlayoutEnabled, isRecordingEnabled, error);
+        return;
+    }
+    NSString *audioMode = VNSEEAAudioSessionModeForEngine();
+    if (![audioSession setMode:audioMode error:&error]) {
+        VNSEEALogWebRTCAudioSessionState(
+            @"native_webrtc_audio_session_config_error", isPlayoutEnabled, isRecordingEnabled, error);
+        return;
+    }
+    if (![audioSession setPreferredSampleRate:48000.0 error:&error]) {
+        VNSEEALogWebRTCAudioSessionState(
+            @"native_webrtc_audio_session_config_error", isPlayoutEnabled, isRecordingEnabled, error);
+        return;
+    }
+    if (![audioSession setPreferredIOBufferDuration:0.01 error:&error]) {
+        VNSEEALogWebRTCAudioSessionState(
+            @"native_webrtc_audio_session_config_error", isPlayoutEnabled, isRecordingEnabled, error);
+        return;
+    }
+    if (![audioSession setActive:YES error:&error]) {
+        VNSEEALogWebRTCAudioSessionState(
+            @"native_webrtc_audio_session_config_error", isPlayoutEnabled, isRecordingEnabled, error);
+        return;
+    }
+    VNSEEAEnsureValidRecordingRoute(isPlayoutEnabled, isRecordingEnabled);
+
+    VNSEEALogWebRTCAudioSessionState(
+        @"native_webrtc_audio_session_configured", isPlayoutEnabled, isRecordingEnabled, nil);
+}
+
+static void VNSEEAUnmuteMicrophoneForRecordingEngine(
+    RTCAudioDeviceModule *audioDeviceModule,
+    BOOL isPlayoutEnabled,
+    BOOL isRecordingEnabled) {
+    if (!isRecordingEnabled || audioDeviceModule == nil) {
+        return;
+    }
+
+    NSInteger result = [audioDeviceModule setMicrophoneMuted:NO];
+    AVAudioSession *audioSession = [AVAudioSession sharedInstance];
+    NSLog(
+        @"[VNSEEA_CALL_DEBUG] {\"event\":\"native_webrtc_audio_microphone_unmuted\",\"result\":%ld,\"isMicrophoneMuted\":%@,\"isPlayoutEnabled\":%@,\"isRecordingEnabled\":%@,\"category\":\"%@\",\"mode\":\"%@\",\"inputAvailable\":%@,\"recordPermission\":\"%@\",\"sampleRate\":%.0f,\"ioBufferDuration\":%.4f}",
+        (long)result,
+        audioDeviceModule.isMicrophoneMuted ? @"true" : @"false",
+        isPlayoutEnabled ? @"true" : @"false",
+        isRecordingEnabled ? @"true" : @"false",
+        audioSession.category ?: @"",
+        audioSession.mode ?: @"",
+        audioSession.isInputAvailable ? @"true" : @"false",
+        VNSEEARecordPermissionName(audioSession.recordPermission),
+        audioSession.sampleRate,
+        audioSession.IOBufferDuration);
+}
+
+static void VNSEEASchedulePostStartAudioProbe(
+    RTCAudioDeviceModule *audioDeviceModule,
+    AVAudioEngine *engine,
+    BOOL isPlayoutEnabled,
+    BOOL isRecordingEnabled) {
+    if (!isRecordingEnabled || audioDeviceModule == nil) {
+        return;
+    }
+
+    RTCAudioDeviceModule *capturedAudioDeviceModule = audioDeviceModule;
+    AVAudioEngine *capturedEngine = engine;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.25 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        VNSEEAConfigureAudioSessionForEngine(isPlayoutEnabled, isRecordingEnabled);
+        VNSEEAUnmuteMicrophoneForRecordingEngine(capturedAudioDeviceModule, isPlayoutEnabled, isRecordingEnabled);
+        VNSEEALogWebRTCAudioInputProbe(
+            @"native_webrtc_audio_post_start_probe",
+            capturedAudioDeviceModule,
+            capturedEngine,
+            isPlayoutEnabled,
+            isRecordingEnabled,
+            nil);
+    });
+}
