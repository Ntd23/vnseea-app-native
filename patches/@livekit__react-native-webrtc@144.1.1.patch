+    VNSEEACallKitVoiceAudioTrace(@"after_activate");
+
+    return VNSEEAWebRTCAudioSessionState(@"activate", configurationError, activeError);
 }

 RCT_EXPORT_BLOCKING_SYNCHRONOUS_METHOD(audioSessionDidDeactivate) {
     [[RTCAudioSession sharedInstance] audioSessionDidDeactivate:[AVAudioSession sharedInstance]];
-    return nil;
+    return VNSEEAWebRTCAudioSessionState(@"deactivate", nil, nil);
+}
+
+RCT_EXPORT_BLOCKING_SYNCHRONOUS_METHOD(audioSessionDebugState) {
+    return VNSEEAWebRTCAudioSessionState(@"debug", nil, nil);
 }

 @end
