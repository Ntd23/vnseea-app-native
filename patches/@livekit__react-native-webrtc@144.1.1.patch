+static NSString *VNSEEAPortTypesForAudioSessionPorts(NSArray<AVAudioSessionPortDescription *> *ports) {
+    NSMutableArray<NSString *> *portTypes = [NSMutableArray array];
+    for (AVAudioSessionPortDescription *port in ports) {
+        if (port.portType != nil) {
+            [portTypes addObject:port.portType];
+        }
+    }
+    return [portTypes componentsJoinedByString:@","];
+}
+
+static NSString *VNSEEARecordPermissionName(AVAudioSessionRecordPermission permission) {
+    switch (permission) {
+        case AVAudioSessionRecordPermissionGranted:
+            return @"granted";
+        case AVAudioSessionRecordPermissionDenied:
+            return @"denied";
+        case AVAudioSessionRecordPermissionUndetermined:
+        default:
+            return @"undetermined";
+    }
+}
+
+static void VNSEEALogWebRTCAudioSessionState(
+    NSString *event,
+    BOOL isPlayoutEnabled,
+    BOOL isRecordingEnabled,
+    NSError *error) {
+    AVAudioSession *audioSession = [AVAudioSession sharedInstance];
+    AVAudioSessionRouteDescription *route = audioSession.currentRoute;
+    NSLog(
+        @"[VNSEEA_CALL_DEBUG] {\"event\":\"%@\",\"isPlayoutEnabled\":%@,\"isRecordingEnabled\":%@,\"category\":\"%@\",\"mode\":\"%@\",\"inputAvailable\":%@,\"recordPermission\":\"%@\",\"sampleRate\":%.0f,\"ioBufferDuration\":%.4f,\"inputs\":\"%@\",\"outputs\":\"%@\",\"error\":\"%@\"}",
+        event,
+        isPlayoutEnabled ? @"true" : @"false",
+        isRecordingEnabled ? @"true" : @"false",
+        audioSession.category ?: @"",
+        audioSession.mode ?: @"",
+        audioSession.isInputAvailable ? @"true" : @"false",
+        VNSEEARecordPermissionName(audioSession.recordPermission),
+        audioSession.sampleRate,
+        audioSession.IOBufferDuration,
+        VNSEEAPortTypesForAudioSessionPorts(route.inputs),
+        VNSEEAPortTypesForAudioSessionPorts(route.outputs),
+        error.localizedDescription ?: @"");
+}
+
+static BOOL VNSEEAShouldUseVoiceCallAudioSession(BOOL isRecordingEnabled) {
+    if (isRecordingEnabled) {
+        return YES;
+    }
+
+    AVAudioSession *audioSession = [AVAudioSession sharedInstance];
+    return [audioSession.category isEqualToString:AVAudioSessionCategoryPlayAndRecord] &&
+        ([audioSession.mode isEqualToString:AVAudioSessionModeVoiceChat] ||
+         [audioSession.mode isEqualToString:AVAudioSessionModeVideoChat]);
+}
+
+static NSString *VNSEEAAudioSessionModeForEngine(void) {
+    AVAudioSession *audioSession = [AVAudioSession sharedInstance];
+    if ([audioSession.mode isEqualToString:AVAudioSessionModeVideoChat]) {
+        return AVAudioSessionModeVideoChat;
+    }
+    return AVAudioSessionModeVoiceChat;
 }
 
+static void VNSEEAConfigureAudioSessionForEngine(BOOL isPlayoutEnabled, BOOL isRecordingEnabled) {
+    if (!VNSEEAShouldUseVoiceCallAudioSession(isRecordingEnabled)) {
+        return;
+    }
+
+    NSError *error = nil;
+    AVAudioSession *audioSession = [AVAudioSession sharedInstance];
+    AVAudioSessionCategoryOptions categoryOptions =
+        AVAudioSessionCategoryOptionAllowBluetooth |
+        AVAudioSessionCategoryOptionDefaultToSpeaker |
+        AVAudioSessionCategoryOptionMixWithOthers;
+
+    if (![audioSession setCategory:AVAudioSessionCategoryPlayAndRecord
+                       withOptions:categoryOptions
+                             error:&error]) {
+        VNSEEALogWebRTCAudioSessionState(
+            @"native_webrtc_audio_session_config_error", isPlayoutEnabled, isRecordingEnabled, error);
+        return;
+    }
+    NSString *audioMode = VNSEEAAudioSessionModeForEngine();
+    if (![audioSession setMode:audioMode error:&error]) {
+        VNSEEALogWebRTCAudioSessionState(
+            @"native_webrtc_audio_session_config_error", isPlayoutEnabled, isRecordingEnabled, error);
+        return;
+    }
+    if (![audioSession setPreferredSampleRate:48000.0 error:&error]) {
+        VNSEEALogWebRTCAudioSessionState(
+            @"native_webrtc_audio_session_config_error", isPlayoutEnabled, isRecordingEnabled, error);
+        return;
+    }
+    if (![audioSession setPreferredIOBufferDuration:0.01 error:&error]) {
+        VNSEEALogWebRTCAudioSessionState(
+            @"native_webrtc_audio_session_config_error", isPlayoutEnabled, isRecordingEnabled, error);
+        return;
+    }
+    if (![audioSession setActive:YES error:&error]) {
+        VNSEEALogWebRTCAudioSessionState(
+            @"native_webrtc_audio_session_config_error", isPlayoutEnabled, isRecordingEnabled, error);
+        return;
+    }
+
+    VNSEEALogWebRTCAudioSessionState(
+        @"native_webrtc_audio_session_configured", isPlayoutEnabled, isRecordingEnabled, nil);
+}
+
+static void VNSEEAUnmuteMicrophoneForRecordingEngine(
+    RTCAudioDeviceModule *audioDeviceModule,
+    BOOL isPlayoutEnabled,
+    BOOL isRecordingEnabled) {
+    if (!isRecordingEnabled || audioDeviceModule == nil) {
+        return;
+    }
+
+    NSInteger result = [audioDeviceModule setMicrophoneMuted:NO];
+    AVAudioSession *audioSession = [AVAudioSession sharedInstance];
+    NSLog(
+        @"[VNSEEA_CALL_DEBUG] {\"event\":\"native_webrtc_audio_microphone_unmuted\",\"result\":%ld,\"isMicrophoneMuted\":%@,\"isPlayoutEnabled\":%@,\"isRecordingEnabled\":%@,\"category\":\"%@\",\"mode\":\"%@\",\"inputAvailable\":%@,\"recordPermission\":\"%@\",\"sampleRate\":%.0f,\"ioBufferDuration\":%.4f}",
+        (long)result,
+        audioDeviceModule.isMicrophoneMuted ? @"true" : @"false",
+        isPlayoutEnabled ? @"true" : @"false",
+        isRecordingEnabled ? @"true" : @"false",
+        audioSession.category ?: @"",
+        audioSession.mode ?: @"",
+        audioSession.isInputAvailable ? @"true" : @"false",
+        VNSEEARecordPermissionName(audioSession.recordPermission),
+        audioSession.sampleRate,
+        audioSession.IOBufferDuration);
+}
