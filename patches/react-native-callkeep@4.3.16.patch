+static NSString *VNSEEAPortTypesForAudioSessionPorts(NSArray<AVAudioSessionPortDescription *> *ports) {
+    NSMutableArray<NSString *> *portTypes = [NSMutableArray array];
+    for (AVAudioSessionPortDescription *port in ports) {
+        if (port.portType != nil) {
+            [portTypes addObject:port.portType];
+        }
+    }
+    return [portTypes componentsJoinedByString:@","];
+}
+
+static NSString *VNSEEARecordPermissionName(AVAudioSessionRecordPermission permission) {
+    switch (permission) {
+        case AVAudioSessionRecordPermissionGranted:
+            return @"granted";
+        case AVAudioSessionRecordPermissionDenied:
+            return @"denied";
+        case AVAudioSessionRecordPermissionUndetermined:
+        default:
+            return @"undetermined";
+    }
+}
+
+static void VNSEEALogAudioSessionState(NSString *event, NSError *error) {
+    AVAudioSession *audioSession = [AVAudioSession sharedInstance];
+    AVAudioSessionRouteDescription *route = audioSession.currentRoute;
+    NSLog(
+        @"[VNSEEA_CALL_DEBUG] {\"event\":\"%@\",\"category\":\"%@\",\"mode\":\"%@\",\"inputAvailable\":%@,\"recordPermission\":\"%@\",\"sampleRate\":%.0f,\"ioBufferDuration\":%.4f,\"inputs\":\"%@\",\"outputs\":\"%@\",\"error\":\"%@\"}",
+        event,
+        audioSession.category ?: @"",
+        audioSession.mode ?: @"",
+        audioSession.isInputAvailable ? @"true" : @"false",
+        VNSEEARecordPermissionName(audioSession.recordPermission),
+        audioSession.sampleRate,
+        audioSession.IOBufferDuration,
+        VNSEEAPortTypesForAudioSessionPorts(route.inputs),
+        VNSEEAPortTypesForAudioSessionPorts(route.outputs),
+        error.localizedDescription ?: @"");
+}
+
+static void VNSEEABridgeRTCAudioSession(SEL selector, AVAudioSession *audioSession, NSString *successEvent, NSString *errorEvent) {
+    Class rtcAudioSessionClass = NSClassFromString(@"RTCAudioSession");
+    SEL sharedInstanceSelector = NSSelectorFromString(@"sharedInstance");
+    if (rtcAudioSessionClass == nil || ![rtcAudioSessionClass respondsToSelector:sharedInstanceSelector]) {
+        VNSEEALogAudioSessionState(errorEvent, nil);
+        return;
+    }
+
+    id (*sharedInstance)(id, SEL) = (id (*)(id, SEL))objc_msgSend;
+    id rtcAudioSession = sharedInstance(rtcAudioSessionClass, sharedInstanceSelector);
+    if (rtcAudioSession == nil || ![rtcAudioSession respondsToSelector:selector]) {
+        VNSEEALogAudioSessionState(errorEvent, nil);
+        return;
+    }
+
+    void (*bridgeCall)(id, SEL, AVAudioSession *) = (void (*)(id, SEL, AVAudioSession *))objc_msgSend;
+    bridgeCall(rtcAudioSession, selector, audioSession);
+    VNSEEALogAudioSessionState(successEvent, nil);
+}
+
+static void VNSEEABridgeRTCAudioSessionDidActivate(AVAudioSession *audioSession) {
+    VNSEEABridgeRTCAudioSession(
+        NSSelectorFromString(@"audioSessionDidActivate:"),
+        audioSession,
+        @"native_callkit_audio_session_activated",
+        @"native_callkit_audio_session_activate_error");
+}
+
+static void VNSEEABridgeRTCAudioSessionDidDeactivate(AVAudioSession *audioSession) {
+    VNSEEABridgeRTCAudioSession(
+        NSSelectorFromString(@"audioSessionDidDeactivate:"),
+        audioSession,
+        @"native_callkit_audio_session_deactivated",
+        @"native_callkit_audio_session_deactivate_error");
+}
+
+static void VNSEEAConfigureCallKitAudioSession(AVAudioSession *audioSession) {
+    NSError *error = nil;
+    AVAudioSessionCategoryOptions categoryOptions =
+        AVAudioSessionCategoryOptionAllowBluetooth |
+        AVAudioSessionCategoryOptionDefaultToSpeaker |
+        AVAudioSessionCategoryOptionMixWithOthers;
+
+    if (![audioSession setCategory:AVAudioSessionCategoryPlayAndRecord
+                       withOptions:categoryOptions
+                             error:&error]) {
+        VNSEEALogAudioSessionState(@"native_callkit_audio_session_config_error", error);
+        return;
+    }
+    if (![audioSession setMode:AVAudioSessionModeVoiceChat error:&error]) {
+        VNSEEALogAudioSessionState(@"native_callkit_audio_session_config_error", error);
+        return;
+    }
+    if (![audioSession setPreferredSampleRate:48000.0 error:&error]) {
+        VNSEEALogAudioSessionState(@"native_callkit_audio_session_config_error", error);
+        return;
+    }
+    if (![audioSession setPreferredIOBufferDuration:0.01 error:&error]) {
+        VNSEEALogAudioSessionState(@"native_callkit_audio_session_config_error", error);
+        return;
+    }
+    if (![audioSession setActive:YES error:&error]) {
+        VNSEEALogAudioSessionState(@"native_callkit_audio_session_config_error", error);
+        return;
+    }
+
+    VNSEEALogAudioSessionState(@"native_callkit_audio_session_configured", nil);
+}
