<script>
(function ($) {
  var lastScrollTop = 0;
  var ticking = false;
  var hideThreshold = 64;
  var deltaThreshold = 10;

  function getAppScrollTop() {
    var containerTop = $('.content-container').scrollTop() || 0;
    var bodyTop = document.body ? (document.body.scrollTop || 0) : 0;
    return Math.max(
      window.pageYOffset || 0,
      document.documentElement.scrollTop || 0,
      bodyTop,
      containerTop
    );
  }

  function closeAppShellOverlays() {
    $('.app-shell-header .dropdown.open').removeClass('open');
    appCloseSearchPanel();
  }

  function setHeaderVisibility(forceShow) {
    var $header = $('.app-shell-header');
    if (!$header.length) {
      return;
    }

    var currentTop = getAppScrollTop();

    if (forceShow || currentTop <= 8) {
      $header.removeClass('is-hidden');
      lastScrollTop = currentTop;
      return;
    }

    if (Math.abs(currentTop - lastScrollTop) < deltaThreshold) {
      return;
    }

    if (currentTop > lastScrollTop && currentTop > hideThreshold) {
      closeAppShellOverlays();
      $header.addClass('is-hidden');
    } else {
      $header.removeClass('is-hidden');
    }

    lastScrollTop = currentTop;
  }

  function onScroll() {
    if (ticking) {
      return;
    }
    ticking = true;
    window.requestAnimationFrame(function () {
      setHeaderVisibility(false);
      ticking = false;
    });
  }

  function appSearchState() {
    return {
      $panel: $('#app-shell-search-panel'),
      $toggle: $('[data-app-search-toggle]'),
      $input: $('#app-shell-search-input'),
      $results: $('#app-shell-search-results'),
      $advanced: $('#app-shell-search-advanced'),
      $link: $('#app-shell-search-link'),
      $repeat: $('#app-shell-repeat-search')
    };
  }

  function appSearchUrl(query) {
    var trimmed = $.trim(query || '');
    if (!trimmed) {
      return {
        href: '<?php echo Wo_SeoLink('index.php?link1=search'); ?>',
        ajax: '?link1=search'
      };
    }

    return {
      href: '<?php echo Wo_SeoLink('index.php?link1=search&query='); ?>' + encodeURIComponent(trimmed),
      ajax: '?link1=search&query=' + encodeURIComponent(trimmed)
    };
  }

  function appUpdateSearchLink(query) {
    var state = appSearchState();
    var trimmed = $.trim(query || '');
    var searchUrl = appSearchUrl(trimmed);

    state.$repeat.text(trimmed);
    state.$link.attr('href', searchUrl.href).attr('data-ajax', searchUrl.ajax);
    state.$advanced.toggle(!!trimmed);
  }

  function appShowNoResult() {
    appSearchState().$results.html('<span class="center-text"><?php echo addslashes($wo['lang']['no_result']); ?></span>');
  }

  function appOpenSearchPanel() {
    var state = appSearchState();
    state.$panel.addClass('is-open').attr('aria-hidden', 'false');
    state.$toggle.attr('aria-expanded', 'true').addClass('is-active');
    setHeaderVisibility(true);
    setTimeout(function () {
      state.$input.trigger('focus');
      if (!$.trim(state.$input.val())) {
        appGetRecentSearches();
      }
    }, 0);
  }

  function appCloseSearchPanel() {
    var state = appSearchState();
    state.$panel.removeClass('is-open').attr('aria-hidden', 'true');
    state.$toggle.attr('aria-expanded', 'false');
    if (!$('body').hasClass('page-search')) {
      state.$toggle.removeClass('is-active');
    }
  }

  function appClearSearches() {
    $.get(Wo_Ajax_Requests_File(), {f: 'clearChat'}, function (data) {
      if (data.status == 200) {
        appGetRecentSearches();
      }
    });
  }

  function appGetRecentSearches() {
    var state = appSearchState();
    appUpdateSearchLink('');
    $.get(Wo_Ajax_Requests_File(), {f: 'search', s: 'recent'}, function (data) {
      if (data.status == 200 && data.html.length > 0) {
        state.$results.html(
          '<div class="recent">' +
            '<div class="gray recent-searches <?php echo Wo_RightToLeft("pull-left"); ?>"><?php echo addslashes($wo["lang"]["recent_searches"]); ?></div>' +
            '<div class="gray recent-searches clear-searches pointer <?php echo Wo_RightToLeft("pull-right"); ?>" style="color:#F44336;" data-app-clear-searches="true">' +
              '<svg style="vertical-align:middle;margin-top:-3px;" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg><?php echo addslashes($wo["lang"]["clear"]); ?>' +
            '</div><div class="clear"></div></div>' + data.html
        );
        return;
      }
      state.$results.empty();
    });
  }

  function appSearchResult(query, mode) {
    var state = appSearchState();
    var trimmed = $.trim(query || '');
    if (!trimmed) {
      appGetRecentSearches();
      return;
    }

    appUpdateSearchLink(trimmed);
    $.get(Wo_Ajax_Requests_File(), {f: 'search', s: mode, query: trimmed}, function (data) {
      if (data.status == 200) {
        if (data.html.length > 0) {
          state.$results.html(data.html);
        } else {
          appShowNoResult();
        }
        return;
      }
      appShowNoResult();
    });
  }

  function appDetectSearchType(query) {
    var trimmed = $.trim(query || '');
    var isHash = typeof smokeTheHash === 'function'
      ? smokeTheHash(trimmed)
      : trimmed.indexOf('#') !== -1;

    if (!trimmed) {
      appGetRecentSearches();
      return;
    }

    if (isHash) {
      appSearchState().$advanced.hide();
      appSearchResult(trimmed, 'hash');
      return;
    }

    appSearchState().$advanced.show();
    appSearchResult(trimmed, 'normal');
  }

  window.Wo_UpdateAppShellState = function (page) {
    var p = String(page || '').toLowerCase();
    var createPages  = ['create-album','create-ads','create-blog','create-event','create-group','create-page','create_blog','edit-blog','create-ai-blog'];
    var searchPages  = ['search','explore','most_liked','products','blogs','forum','movies','jobs'];
    var profilePages = ['timeline','setting','wallet','subscriptions'];
    var key = 'home';
    if (createPages.indexOf(p)  !== -1) key = 'create';
    else if (searchPages.indexOf(p) !== -1) key = 'search';
    else if (p === 'messages')  key = 'messages';
    else if (profilePages.indexOf(p) !== -1) key = 'profile';
    $('.app-shell-header').find('[data-app-nav]').removeClass('is-active');
    $('.app-shell-header').find('[data-app-nav="' + key + '"]').addClass('is-active');
    setHeaderVisibility(true);
  };

  $(function () {
    window.Wo_UpdateAppShellState('<?php echo $wo['page']; ?>');
    $(window).add(document).add(document.body).add($('.content-container'))
      .off('scroll.appShellHeader')
      .on('scroll.appShellHeader', onScroll);
    $(document)
      .off('shown.bs.dropdown.appShell hidden.bs.dropdown.appShell click.appShellSearch')
      .on('shown.bs.dropdown.appShell hidden.bs.dropdown.appShell', '.app-shell-header .dropdown', function () {
        setHeaderVisibility(true);
      })
      .on('click.appShellSearch', '[data-app-search-toggle]', function (event) {
        event.preventDefault();
        if (appSearchState().$panel.hasClass('is-open')) {
          appCloseSearchPanel();
          return;
        }
        appOpenSearchPanel();
      })
      .on('click.appShellSearch', '[data-app-clear-searches]', function (event) {
        event.preventDefault();
        appClearSearches();
      })
      .on('click.appShellSearch', '#app-shell-search-results a, #app-shell-search-link', function () {
        appCloseSearchPanel();
      })
      .on('click.appShellSearch', function (event) {
        var $target = $(event.target);
        if (!$target.closest('#app-shell-search-panel, [data-app-search-toggle]').length) {
          appCloseSearchPanel();
        }
      });

    $('#app-shell-search-input')
      .off('focus.appShellSearch input.appShellSearch keydown.appShellSearch')
      .on('focus.appShellSearch', function () {
        if (!$.trim(this.value)) {
          appGetRecentSearches();
        }
      })
      .on('input.appShellSearch', function () {
        appDetectSearchType(this.value);
      })
      .on('keydown.appShellSearch', function (event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          window.location.href = appSearchUrl(this.value).href;
        }
      });
  });
})(jQuery);
</script>
