# English description: Example local runtime environment for Nuxt, PHP backend bridge, realtime, and PHP-CGI upstreams.
NUXT_PUBLIC_API_BASE=/_api
NUXT_BACKEND_API_BASE=http://v2.vnseea.test:8080
# NUXT_BACKEND_SERVER_KEY=9c03123383d80bb136cb432d14141ba1
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# NUXT_PUBLIC_BACKEND_WEB_BASE=https://v2.vnseea.test
NUXT_DEV_HOST=127.0.0.1
NUXT_DEV_PORT=3000
NUXT_ALLOWED_HOSTS=v2.vnseea.test
NUXT_PUBLIC_REALTIME_URL=http://127.0.0.1:3025
NUXT_PUBLIC_SCRIPTS_GOOGLE_MAPS_API_KEY=
NUXT_SCRIPTS_PROXY_SECRET=
REALTIME_INTERNAL_URL=http://127.0.0.1:3025
# REALTIME_SECRET=7a9377d578bbde90412f41759097b26be05184f45387b85106a3a05257b04301
REALTIME_PORT=3025
PHP_UPSTREAM_HOST=127.0.0.1
PHP_UPSTREAM_PORTS=9003,9004,9005,9006,9007,9008,9009,9010
# PHP_CGI_BIN=D:\path\to\php-cgi.exe
# PHP_INI_PATH=D:\path\to\php.ini
# PHP_UPSTREAM_CHECK_INTERVAL_MS=5000
# PHP_UPSTREAM_RESPAWN_COOLDOWN_MS=15000
# PHP_FCGI_CHILDREN=1
# PHP_FCGI_MAX_REQUESTS=0

