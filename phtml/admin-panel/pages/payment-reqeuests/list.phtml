<?php
$withdrawal_transfer_info_raw = !empty($wo['userlist']['transfer_info']) ? html_entity_decode($wo['userlist']['transfer_info'], ENT_QUOTES, 'UTF-8') : '';
$withdrawal_transfer_info = json_decode($withdrawal_transfer_info_raw, true);
if (!is_array($withdrawal_transfer_info)) {
   $withdrawal_transfer_info = array();
}

$withdrawal_bank_code = !empty($withdrawal_transfer_info['bank_code']) ? $withdrawal_transfer_info['bank_code'] : '';
$withdrawal_bank_name = !empty($withdrawal_transfer_info['bank_name']) ? $withdrawal_transfer_info['bank_name'] : '';
$withdrawal_account_number = !empty($withdrawal_transfer_info['account_number']) ? $withdrawal_transfer_info['account_number'] : '';
$withdrawal_beneficiary_name = !empty($withdrawal_transfer_info['beneficiary_name']) ? $withdrawal_transfer_info['beneficiary_name'] : '';
$withdrawal_payment_code = 'WD-' . $wo['userlist']['id'];
$withdrawal_currency = !empty($wo['config']['ads_currency']) ? $wo['config']['ads_currency'] : $wo['config']['currency'];
$withdrawal_formatted_amount = Wo_GetCurrency($withdrawal_currency) . Wo_FormatPriceByCurrency($wo['userlist']['amount'], $withdrawal_currency);
$withdrawal_qr_amount = (string) max(0, (int) round((float) preg_replace('/[^0-9.\-]/', '', (string) $wo['userlist']['amount'])));
$withdrawal_qr_url = '';

if ($wo['userlist']['type'] == 'sepay' && !empty($withdrawal_bank_code) && !empty($withdrawal_account_number) && $withdrawal_qr_amount !== '0') {
   $withdrawal_qr_url = 'https://img.vietqr.io/image/' . rawurlencode($withdrawal_bank_code) . '-' . rawurlencode($withdrawal_account_number) . '-compact2.png?amount=' . rawurlencode($withdrawal_qr_amount) . '&addInfo=' . rawurlencode($withdrawal_payment_code) . '&accountName=' . rawurlencode($withdrawal_beneficiary_name);
}
?>
<tr id="UserID_<?php echo $wo['userlist']['id']?>" data-user-id="<?php echo $wo['userlist']['user']['user_id']?>" data_selected="<?php echo $wo['userlist']['id']?>">
   <td><input type="checkbox" id="check-data-<?php echo $wo['userlist']['id']?>" class="delete-checkbox filled-in"><label for="check-data-<?php echo $wo['userlist']['id']?>"></label></td>
   <td><?php echo $wo['userlist']['id']?></td>
   <td>
      <a href="<?php echo $wo['userlist']['user']['url']; ?>">
         <img src="<?php echo $wo['userlist']['user']['avatar']; ?>" class="setting-avatar" alt="<?php echo $wo['userlist']['user']['avatar']?> Profile Picture">
         <?php echo $wo['userlist']['user']['name']; ?>
      </a>
   </td>
   <td><?php echo $wo['userlist']['user']['paypal_email'];?></td>
   <td><?php echo htmlspecialchars($withdrawal_formatted_amount, ENT_QUOTES, 'UTF-8'); ?></td>
   <td>
      <?php if (!empty($withdrawal_qr_url)) { ?>
         <div class="withdrawal-payment-qr">
            <strong class="withdrawal-payment-qr__code"><?php echo htmlspecialchars($withdrawal_payment_code, ENT_QUOTES, 'UTF-8'); ?></strong>
            <img src="<?php echo htmlspecialchars($withdrawal_qr_url, ENT_QUOTES, 'UTF-8'); ?>" alt="Withdrawal payment QR">
            <p class="withdrawal-payment-qr__meta"><?php echo htmlspecialchars($withdrawal_bank_name . ' - ' . $withdrawal_account_number, ENT_QUOTES, 'UTF-8'); ?></p>
            <p class="withdrawal-payment-qr__meta"><?php echo htmlspecialchars($withdrawal_beneficiary_name, ENT_QUOTES, 'UTF-8'); ?></p>
            <p class="withdrawal-payment-qr__meta"><?php echo htmlspecialchars($withdrawal_formatted_amount, ENT_QUOTES, 'UTF-8'); ?></p>
         </div>
      <?php } else { ?>
         <span>-</span>
      <?php } ?>
   </td>
   <td>
      <?php
      if ($wo['userlist']['status'] == 0) {
         echo '<span class="label label-warning">Pending</span>';
      } else if ($wo['userlist']['status'] == 1) {
         echo '<span class="label label-success">Approved</span>';
      } else if ($wo['userlist']['status'] == 2) {
         echo '<span class="label label-danger">Declined</span>';
      }
      ?>
   </td>
   <td>
      <button onclick="Wo_MarkPaid(<?php echo $wo['userlist']['id']?>,'hide');" type="button" class="btn bg-success admn_table_btn">Đã trả</button>
      <button onclick="Wo_DeclinePayment(<?php echo $wo['userlist']['id']?>,'hide');" type="button" class="btn bg-danger admn_table_btn">Từ chối</button>
   </td>
</tr>
