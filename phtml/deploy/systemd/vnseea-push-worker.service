[Unit]
Description=VNSEEA push delivery worker
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=vnseea
Group=vnseea
WorkingDirectory=/home/vnseea/domains/vnseea.vn/main
ExecStart=/usr/bin/php /home/vnseea/domains/vnseea.vn/main/workers/push-delivery-worker.php --batch=50 --idle-ms=500 --max-memory-mb=192
Restart=always
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
